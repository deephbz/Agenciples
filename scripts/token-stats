#!/usr/bin/env python3
"""Print a tree of estimated token changes in the L0, L1, and L2 files.

A token is estimated as 4 characters. Layer rows count every file in the
layer; file rows list only the changed files.

  scripts/token-stats            HEAD -> working tree
  scripts/token-stats --cached   HEAD -> index (what the next commit adds)
  scripts/token-stats A [B]      commit A -> commit B (default HEAD); A..B also works
  scripts/token-stats --hook MSGFILE [SOURCE]
                                 prepare-commit-msg mode: put the tree for the
                                 staged change into the message, before trailers
"""
import difflib
import fnmatch
import re
import subprocess
import sys

LAYERS = [
    ("L0 always on", ["AGENTS-snippet.md"]),
    ("L1 skills", ["*/SKILL.md"]),
    ("L2 references", ["work-os/references/*.md"]),
]
WORKTREE, INDEX = None, ":"


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def files(rev):
    if rev is WORKTREE:
        listed = git("ls-files", "--cached", "--others", "--exclude-standard")
    else:
        listed = git("ls-files") if rev == INDEX else git("ls-tree", "-r", "--name-only", rev)
    return set(listed.splitlines())


def read(rev, path):
    try:
        if rev is WORKTREE:
            with open(path, encoding="utf-8") as f:
                return f.read()
        return git("show", (":" if rev == INDEX else rev + ":") + path)
    except (OSError, subprocess.CalledProcessError):
        return ""


def line_changes(old, new):
    """Characters on added and removed lines, from a line diff."""
    added = removed = 0
    a, b = old.splitlines(keepends=True), new.splitlines(keepends=True)
    for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if op in ("replace", "delete"):
            removed += sum(map(len, a[i1:i2]))
        if op in ("replace", "insert"):
            added += sum(map(len, b[j1:j2]))
    return added, removed


def tokens(chars):
    return round(chars / 4)


def report(old, new, label):
    """Return the tree as lines, or [] when no layer file changed."""
    layers = []
    paths = files(old) | files(new)
    for name, patterns in LAYERS:
        stats = []
        for path in sorted(p for p in paths if any(fnmatch.fnmatch(p, g) for g in patterns)):
            before, after = read(old, path), read(new, path)
            stats.append((path, len(before), len(after), *line_changes(before, after)))
        layers.append((name, stats))
    everything = [s for _, stats in layers for s in stats]
    if not any(s[3] or s[4] for s in everything):
        return []

    def cells(before, after, add, rem):
        net = tokens(after - before)
        return [str(tokens(before)), str(tokens(after)), f"+{tokens(add)}", f"-{tokens(rem)}", f"{net:+d}"]

    def total(stats):
        return [sum(s[i] for s in stats) for i in range(1, 5)]

    rows = [(f"Tokens (chars/4), {label}", cells(*total(everything)))]
    for li, (name, stats) in enumerate(layers):
        last_layer = li == len(layers) - 1
        changed = [s for s in stats if s[3] or s[4]]
        if len(changed) < len(stats):
            name += f" ({len(stats) - len(changed)} unchanged)"
        rows.append((("└── " if last_layer else "├── ") + name, cells(*total(stats))))
        for fi, (path, *values) in enumerate(changed):
            stem = "    " if last_layer else "│   "
            branch = "└── " if fi == len(changed) - 1 else "├── "
            rows.append((stem + branch + path, cells(*values)))

    header = ["before", "after", "added", "removed", "net"]
    width = max(len(name) for name, _ in rows)
    cols = [max(len(h), *(len(c[i]) for _, c in rows)) for i, h in enumerate(header)]
    lines = [" " * width + "".join("  " + h.rjust(w) for h, w in zip(header, cols))]
    for name, c in rows:
        lines.append(name.ljust(width) + "".join("  " + v.rjust(w) for v, w in zip(c, cols)))
    return lines


TRAILER = re.compile(r"^[A-Za-z][A-Za-z0-9-]*: ")


def hook(msgfile, source=""):
    """Replace any earlier tree in the message, and put the new one before trailers."""
    if source in ("merge", "squash"):
        return
    # An amend or -c/-C reuses a commit; compare against the parent of HEAD.
    base = "HEAD~1" if source == "commit" else "HEAD"
    # The first commit has no parent; compare against the empty tree.
    if subprocess.run(["git", "rev-parse", "-q", "--verify", base], capture_output=True).returncode:
        base = git("hash-object", "-t", "tree", "/dev/null").strip()
    with open(msgfile, encoding="utf-8") as f:
        text = f.read()
    lines = text.split("\n")
    cut = len(lines)
    while cut and (lines[cut - 1].startswith("#") or not lines[cut - 1].strip()):
        cut -= 1
    body, comments = "\n".join(lines[:cut]), lines[cut:]
    paras = [p for p in body.split("\n\n") if "Tokens (chars/4), " not in p]
    tree = report(base, INDEX, "parent -> this commit")
    if tree:
        at = len(paras)
        if at > 1 and all(TRAILER.match(l) for l in paras[-1].splitlines()):
            at -= 1
        paras.insert(at, "\n".join(tree))
    with open(msgfile, "w", encoding="utf-8") as f:
        f.write("\n\n".join(paras) + "\n" + "\n".join(comments))


def main(argv):
    if argv[:1] == ["--hook"] and 2 <= len(argv) <= 4:
        return hook(*argv[1:3])
    if argv == ["--cached"]:
        old, new, label = "HEAD", INDEX, "HEAD -> index"
    elif len(argv) == 1 and ".." in argv[0]:
        old, new = argv[0].split("..", 1)
        new = new or "HEAD"
        label = f"{old} -> {new}"
    elif 1 <= len(argv) <= 2 and not argv[0].startswith("-"):
        old, new = argv[0], argv[1] if len(argv) == 2 else "HEAD"
        label = f"{old} -> {new}"
    elif not argv:
        old, new, label = "HEAD", WORKTREE, "HEAD -> working tree"
    else:
        sys.exit(__doc__)
    print("\n".join(report(old, new, label)) or "No L0, L1, or L2 file changed.")


if __name__ == "__main__":
    main(sys.argv[1:])
